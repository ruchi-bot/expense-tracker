{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A full-stack expense tracker application",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd server && npm install && cd ../client && npm install && cd ..",
    "dev": "concurrently --kill-others \"cd server && npm run dev\" \"cd client && npm start\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "build-server": "cd server && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "keywords": [
    "expense",
    "tracker",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
